    private static Territory_Assignment__c getchoosenTerritoryAssignment(List<Territory_Assignment__c> assignmentRows, String normalizedInputSegment, Map<String, Set<String>> allowedSegmentsBySourceSegment) {
        System.debug('Territory assignments found: ' + assignmentRows.size());
        System.debug('Territory assignments: ' + assignmentRows);
        System.debug('allowedSegmentsBySourceSegment: ' + allowedSegmentsBySourceSegment);
        System.debug('normalizedInputSegment: ' + normalizedInputSegment);

        Set<Id> allChosenTerritoryIds = new Set<Id>();
        List<Territory_Assignment__c> validAssignments = new List<Territory_Assignment__c>();
        Territory_Assignment__c chosenAssignment;
        for (Territory_Assignment__c row : assignmentRows) {
            String normalizedAssignmentSegment = normalizeKeyPart(row.Segment__c);
            System.debug('normalizedAssignmentSegment' + normalizedAssignmentSegment);
            Set<String> allowedSegments = allowedSegmentsBySourceSegment.get(normalizedAssignmentSegment);
            if(allowedSegments != null){
                System.debug('Checking segment: ' + normalizedInputSegment + ' against allowed segments: ' + allowedSegments);
                if (allowedSegments.contains(normalizedInputSegment)) {
                    allChosenTerritoryIds.add(row.TerritorySFId__c);
                    validAssignments.add(row);
                }
            }
        }

        System.debug('All chosen territory IDs: ' + allChosenTerritoryIds);
        
        Id userAssociatedTerritoryId ;
        for (UserTerritory2Association uta : [select id, Territory2Id, UserId from UserTerritory2Association where territory2Id IN :allChosenTerritoryIds]) {
            userAssociatedTerritoryId = uta.Territory2Id;
        }
        System.debug('User associated territory ID: ' + userAssociatedTerritoryId);

        for(Territory_Assignment__c row : validAssignments) {
            if (row.TerritorySFId__c != null && userAssociatedTerritoryId != null && row.TerritorySFId__c == userAssociatedTerritoryId) {
                chosenAssignment = row;
                return chosenAssignment;
            }
        }
        System.debug('Chosen assignment: ' + chosenAssignment);

        return chosenAssignment;

    }




    private static void validateCreateRequest(CreateLeadRequest requestData) {
        System.debug('Validating CreateLeadRequest: ' + JSON.serialize(requestData));
        if (String.isBlank(requestData.company)) {
            throw new AuraHandledException(System.Label.SFA_PJT_CompanyRequiredMessage);
        }
        if (String.isBlank(requestData.lastName)) {
            throw new AuraHandledException(System.Label.SFA_PJT_LastNameRequiredMessage);
        }
        if (String.isBlank(requestData.leadSource)) {
            throw new AuraHandledException(System.Label.SFA_PJT_LeadSourceRequiredMessage);
        }
        if (String.isBlank(requestData.leadType)) {
            throw new AuraHandledException(System.Label.SFA_PJT_LeadTypeRequiredMessage);
        }
        if (String.isBlank(requestData.segmentType)) {
            throw new AuraHandledException(System.Label.SFA_PJT_SegmentTypeRequiredMessage);
        }

        String sanitizedPincode = sanitizePincode(requestData.postalCode);
        if (String.isBlank(sanitizedPincode)) {
            throw new AuraHandledException(System.Label.SFA_PJT_PostalCodeMinDigitsMessage);
        }

        if (!String.isBlank(requestData.mobilePhone) && !isTenDigitNumber(requestData.mobilePhone)) {
            throw new AuraHandledException(System.Label.SFA_PJT_MobileNumberTenDigitsMessage);
        }
        if (!String.isBlank(requestData.contactNumber) && !isTenDigitNumber(requestData.contactNumber)) {
            throw new AuraHandledException(System.Label.SFA_PJT_ContactNumberTenDigitsMessage);
        }
        if (!String.isBlank(requestData.email) && !isValidEmail(requestData.email)) {
            throw new AuraHandledException(System.Label.SFA_PJT_ValidEmailRequiredMessage);
        }

        String normalizedLeadSource = normalizeLeadSource(requestData.leadSource);
        if (normalizedLeadSource == LEAD_SOURCE_CONTRACTOR_RECOMMENDED && requestData.contractorId == null) {
            throw new AuraHandledException(System.Label.SFA_PJT_ContractorRequiredForLeadSourceMessage);
        }
        if (normalizedLeadSource == LEAD_SOURCE_DEALER_RECOMMENDED && requestData.dealerId == null) {
            throw new AuraHandledException(System.Label.SFA_PJT_DealerRequiredForLeadSourceMessage);
        }
        if (normalizedLeadSource == LEAD_SOURCE_SPECIFIER_RECOMMENDED && requestData.specifierId == null) {
            throw new AuraHandledException(System.Label.SFA_PJT_SpecifierRequiredForLeadSourceMessage);
        }
    }

