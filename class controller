    private static String sanitizePincode(String rawValue) {
        if (String.isBlank(rawValue)) {
            return null;
        }

        String digits = '';
        for (Integer i = 0; i < rawValue.length(); i++) {
            String ch = rawValue.substring(i, i + 1);
            if (ch >= '0' && ch <= '9') {
                digits += ch;
            }
        }

        if (digits.length() < 6) {
            return null;
        }
        return digits.substring(0, 6);
    }

    private static Boolean isTenDigitNumber(String value) {
        String digits = value == null ? '' : value.replaceAll('[^0-9]', '');
        return digits.length() == 10;
    }

    private static Boolean isValidEmail(String value) {
        return Pattern.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$', value);
    }

