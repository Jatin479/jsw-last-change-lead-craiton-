    private static Id getOrgWideEmailAddressId() {
        if (cachedOrgWideEmailAddressId != null) {
            return cachedOrgWideEmailAddressId;
        }

        String configuredDisplayName = String.isBlank(System.Label.SFA_PJT_OrgWideEmaiDisplayName) ? ORG_WIDE_EMAIL_FALLBACK_DISPLAY_NAME : System.Label.SFA_PJT_OrgWideEmaiDisplayName.trim();

        try {
            List<OrgWideEmailAddress> rows = [
                SELECT Id
                FROM OrgWideEmailAddress
                WHERE DisplayName = :configuredDisplayName
                LIMIT 1
            ];
            if (!rows.isEmpty()) {
                cachedOrgWideEmailAddressId = rows[0].Id;
            }
        } catch (Exception ex) {
            Logger.error('Failed to retrieve org-wide email address.', '', ex)
                .addTag('Lead Creation');
        } finally {
            Logger.saveLog();
        }

        return cachedOrgWideEmailAddressId;
    }


    private static void notifyUser(Id leadId, Id UserId, String emailTemplateName) {
        if (leadId == null || UserId == null || String.isBlank(emailTemplateName)) {
            return;
        }
        List<String> recipientEmails = new List<String>();

        try {
            for (User user : [
                SELECT Id, Email
                FROM User
                WHERE Id = :UserId
                AND IsActive = true
                AND Email != null
            ]) {
                recipientEmails.add(user.Email);
            }

            if (recipientEmails == null || recipientEmails.isEmpty()) {
                return;
            }

            // Get email template
            List<EmailTemplate> templates = [
                SELECT Id
                FROM EmailTemplate
                WHERE DeveloperName = :emailTemplateName
                LIMIT 1
            ];

            Messaging.SingleEmailMessage email =
                new Messaging.SingleEmailMessage();

            email.setToAddresses(recipientEmails);
            email.setSaveAsActivity(false);

            Id orgWideEmailAddressId = getOrgWideEmailAddressId();
            if (orgWideEmailAddressId != null) {
                email.setOrgWideEmailAddressId(orgWideEmailAddressId);
            } else {
                System.debug(LoggingLevel.WARN, 'Org-wide email address for label SFA_PJT_OrgWideEmaiDisplayName was not found. Using default sender.');
            }

            if (!templates.isEmpty()) {

                email.setTemplateId(templates[0].Id);
                email.setTargetObjectId(leadId);

                // Lead should not receive the email.
                // Actual recipients are the queue members.
                email.setTreatTargetObjectAsRecipient(false);
            }

            Messaging.sendEmail(
                new List<Messaging.SingleEmailMessage>{ email }
            );

        } catch (Exception ex) {
            Logger.error('Failed to send lead co-owner notification email.', leadId, ex)
                .addTag('Lead Creation');
        } finally {
            Logger.saveLog();
        }
    }

    private static void sendBellNotificationToPSM(Id leadId, Id psmUserId, String leadCompanyName) {
        if (leadId == null || psmUserId == null) {
            return; // Nothing to notify - exit quietly.
        }

        try {
            // Look up the Custom Notification Type Id by its DeveloperName.
            // (Configure this Custom Notification Type once in Setup ->
            // Notification Builder -> Custom Notifications.)
            List<CustomNotificationType> notificationTypes = [
                SELECT Id
                FROM CustomNotificationType
                WHERE DeveloperName = :LEAD_CREATED_NOTIFICATION_TYPE_DEV_NAME
                LIMIT 1
            ];

            if (notificationTypes.isEmpty()) {
                // Custom Notification Type not set up yet in this org.
                // Log a warning and skip - do not throw, so Lead creation
                // is unaffected.
                System.debug(
                    LoggingLevel.WARN,
                    'Custom Notification Type "' + LEAD_CREATED_NOTIFICATION_TYPE_DEV_NAME
                        + '" was not found. Bell notification to PSM was skipped.'
                );
                return;
            }

            Messaging.CustomNotification bellNotification = new Messaging.CustomNotification();
            bellNotification.setTitle('New Lead Created');
            bellNotification.setBody(
                String.isBlank(leadCompanyName)
                    ? 'A new Lead has been created and requires your attention.'
                    : 'A new Lead for "' + leadCompanyName + '" has been created and requires your attention.'
            );
            bellNotification.setNotificationTypeId(notificationTypes[0].Id);
            bellNotification.setTargetId(leadId); // Clicking the bell opens this Lead.
            bellNotification.send(new Set<String>{ psmUserId });

        } catch (Exception ex) {
            // Never let a notification failure break Lead creation.
            Logger.error('Failed to send bell (custom) notification to PSM.', leadId, ex)
                .addTag('Lead Creation');
        } finally {
            Logger.saveLog();
        }
    }

    private static void notifyBusinessManagersForUnmappedPin(
        String pincode,
        String segment,
        String track,
        String leadAccountType,
        Id leadId) {
        try {
            // Get the queue
            List<Group> queues = [
                SELECT Id
                FROM Group
                WHERE Type = 'Queue'
                AND DeveloperName = :UNMAPPED_PIN_QUEUE_DEV_NAME
                LIMIT 1
            ];

            if (queues.isEmpty()) {
                return;
            }

            Id queueId = queues[0].Id;

            // Get direct User members of the queue
            Set<Id> userIds = new Set<Id>();

            for (GroupMember member : [
                SELECT UserOrGroupId
                FROM GroupMember
                WHERE GroupId = :queueId
            ]) {
                if (member.UserOrGroupId != null) {
                    userIds.add(member.UserOrGroupId);
                }
            }

            if (userIds.isEmpty()) {
                return;
            }

            // Get active users and their email addresses
            List<String> recipientEmails = new List<String>();

            for (User user : [
                SELECT Id, Email
                FROM User
                WHERE Id IN :userIds
                AND IsActive = true
                AND Email != null
            ]) {
                recipientEmails.add(user.Email);
            }

            if (recipientEmails.isEmpty()) {
                return;
            }

            // Get email template
            List<EmailTemplate> templates = [
                SELECT Id
                FROM EmailTemplate
                WHERE DeveloperName = :UNMAPPED_PIN_TEMPLATE_DEV_NAME
                LIMIT 1
            ];

            Messaging.SingleEmailMessage email =
                new Messaging.SingleEmailMessage();

            email.setToAddresses(recipientEmails);
            email.setSaveAsActivity(false);

            Id orgWideEmailAddressId = getOrgWideEmailAddressId();
            if (orgWideEmailAddressId != null) {
                email.setOrgWideEmailAddressId(orgWideEmailAddressId);
            } else {
                System.debug(LoggingLevel.WARN, 'Org-wide email address for label SFA_PJT_OrgWideEmaiDisplayName was not found. Using default sender.');
            }

            if (!templates.isEmpty()) {
                email.setTemplateId(templates[0].Id);
                email.setTargetObjectId(leadId);

                // Lead should not receive the email.
                // Actual recipients are the queue members.
                email.setTreatTargetObjectAsRecipient(false);

            } 

            Messaging.sendEmail(
                new List<Messaging.SingleEmailMessage>{ email }
            );

        } catch (Exception ex) {
            Logger.error('Failed to send unmapped PIN notification email.', leadId, ex)
                .addTag('Lead Creation');
        } finally {
            Logger.saveLog();
        }
    }


    @TestVisible
    private static String getUserFriendlyDmlMessage(DmlException ex) {
        if (ex == null) {
            return 'Unable to create Lead. Please contact your administrator.';
        }

        String rawMessage = ex.getNumDml() > 0 ? ex.getDmlMessage(0) : ex.getMessage();
        if (String.isBlank(rawMessage)) {
            return 'Unable to create Lead. Please contact your administrator.';
        }

        Integer codeCommaIndex = rawMessage.indexOf(',');
        Integer fieldSectionIndex = rawMessage.lastIndexOf(', [' );
        if (codeCommaIndex > -1 && fieldSectionIndex > codeCommaIndex) {
            String trimmedMessage = rawMessage.substring(codeCommaIndex + 1, fieldSectionIndex).trim();
            if (!String.isBlank(trimmedMessage)) {
                return trimmedMessage;
            }
        }

        return rawMessage;
    }

    private static void putIfCreateable(Lead target, Schema.SObjectField fieldRef, Object value) {
        if (value == null) {
            return;
        }
        if (fieldRef.getDescribe().isCreateable()) {
            target.put(fieldRef, value);
        }
    }
