    @AuraEnabled(cacheable=true)
    public static List<AccountOption> searchAccounts(String searchTerm, String recordTypeDeveloperName, Integer limitSize) {
        List<AccountOption> options = new List<AccountOption>();
        if (String.isBlank(searchTerm) || String.isBlank(recordTypeDeveloperName)) {
            return options;
        }

        Integer effectiveLimit = 10;
        if (limitSize != null && limitSize > 0 && limitSize <= 50) {
            effectiveLimit = limitSize;
        }

        List<RecordType> rtRows = [
            SELECT Id
            FROM RecordType
            WHERE SObjectType = 'Account' AND DeveloperName = :recordTypeDeveloperName
            LIMIT 1
        ];
        if (rtRows.isEmpty()) {
            return options;
        }

        String likeTerm = '%' + searchTerm.trim() + '%';
        for (Account acc : [
            SELECT Id, Name
            FROM Account
            WHERE RecordTypeId = :rtRows[0].Id
              AND Name LIKE :likeTerm
            ORDER BY Name
            LIMIT :effectiveLimit
        ]) {
            options.add(new AccountOption(acc.Id, acc.Name));
        }

        return options;
    }

    @AuraEnabled(cacheable=true)
    public static LeadRecordTypeRoutingResponse getLeadRecordTypeRouting(Id recordTypeId) {
        LeadRecordTypeRoutingResponse response = new LeadRecordTypeRoutingResponse();
        response.recordTypeId = recordTypeId;
        response.isProjectRecordType = false;

        if (recordTypeId == null) {
            return response;
        }

        List<RecordType> recordTypes = [
            SELECT Id, Name, DeveloperName
            FROM RecordType
            WHERE Id = :recordTypeId
              AND SObjectType = 'Lead'
            LIMIT 1
        ];

        if (recordTypes.isEmpty()) {
            return response;
        }

        RecordType rt = recordTypes[0];
        response.recordTypeName = rt.Name;
        response.recordTypeDeveloperName = rt.DeveloperName;

        String devName = String.isBlank(rt.DeveloperName) ? '' : rt.DeveloperName.trim().toLowerCase();
        String labelName = String.isBlank(rt.Name) ? '' : rt.Name.trim().toLowerCase();
        response.isProjectRecordType = devName.contains('project') || labelName.contains('project');

        return response;
    }

    @AuraEnabled(cacheable=true)
    public static LeadRecordTypeRoutingResponse getLeadRecordTypeRoutingForOverride(Id recordTypeId) {
        if (recordTypeId != null) {
            return getLeadRecordTypeRouting(recordTypeId);
        }

        Id resolvedRecordTypeId = getSingleAvailableLeadRecordTypeId();
        return getLeadRecordTypeRouting(resolvedRecordTypeId);
    }

    private static Id getSingleAvailableLeadRecordTypeId() {
        Schema.DescribeSObjectResult leadDescribe = Schema.describeSObjects(new List<String>{ 'Lead' })[0];
        Map<Id, Schema.RecordTypeInfo> leadRecordTypeInfoById = leadDescribe.getRecordTypeInfosById();

        Integer availableCustomRecordTypeCount = 0;
        Id singleRecordTypeId;

        for (Schema.RecordTypeInfo info : leadRecordTypeInfoById.values()) {
            if (info == null || !info.isAvailable() || info.isMaster()) {
                continue;
            }

            availableCustomRecordTypeCount++;
            singleRecordTypeId = info.getRecordTypeId();

            if (availableCustomRecordTypeCount > 1) {
                return null;
            }
        }

        return availableCustomRecordTypeCount == 1 ? singleRecordTypeId : null;
    }

    @AuraEnabled
    public static TerritoryValidationResponse validateTerritory(String leadType, String postalCode, String segmentType) {
        TerritoryValidationResponse response = new TerritoryValidationResponse();
        response.isValid = false;
        response.warningMessage = WARNING_MESSAGE;

        String sanitizedInputPincode = sanitizePincode(postalCode);
        if (String.isBlank(leadType) || String.isBlank(segmentType) || String.isBlank(sanitizedInputPincode)) {
            return response;
        }

        String derivedTrack = deriveTrackFromCurrentUserRole();
        if (String.isBlank(derivedTrack)) {
            return response;
        }

        Set<Id> territory2Ids = new Set<Id>();
        for (UserTerritory2Association uta : [
            SELECT Territory2Id
            FROM UserTerritory2Association
            WHERE UserId = :UserInfo.getUserId()
        ]) {
            territory2Ids.add(uta.Territory2Id);
        }

        if (territory2Ids.isEmpty()) {
            return response;
        }


        System.debug('Derived track: ' + derivedTrack);
        System.debug('Territory2 IDs: ' + territory2Ids);

       

        List<Territory_Assignment__c> assignments = [
            SELECT Id,
                   Pincode__c,
                   Segment__c,
                   TerritoryCode__c,
                   TerritorySFId__c,
                   Track__c,
                   TypeOfAssignment__c
            FROM Territory_Assignment__c
            WHERE Track__c = :derivedTrack
              AND Serviceable__c = true
              AND TypeOfAssignment__c = :ASSIGNMENT_TYPE_LEAD
              AND TerritorySFId__c IN :territory2Ids
              AND Pincode__c = :parsePincodeForQuery(sanitizedInputPincode)
        ];

        System.debug('Territory assignments found: ' + assignments.size());
        System.debug('Territory assignments: ' + assignments);

        if (assignments.isEmpty()) {
            return response;
        }

        Map<String, Set<String>> allowedSegmentsBySourceSegment = getAllowedSegmentsBySourceSegment();
        System.debug('Allowed segments by source segment: ' + allowedSegmentsBySourceSegment);
        
        //Map<String, Id> territoryAssignmentByKey = new Map<String, Id>();
        //String normalizedLeadType = normalizeKeyPart(leadType);
        String normalizedSegmentType = normalizeKeyPart(segmentType);

        //System.debug('Normalized lead type: ' + normalizedLeadType);
        System.debug('Normalized segment type: ' + normalizedSegmentType);
        
        for (Territory_Assignment__c assignment : assignments) {
            String normalizedSourceSegment = normalizeKeyPart(assignment.Segment__c);
            System.debug('Normalized source segment: ' + normalizedSourceSegment);
            Set<String> allowedSegments = allowedSegmentsBySourceSegment.get(normalizedSourceSegment);
            if(allowedSegments != null){
                System.debug('Allowed segments for source segment ' + normalizedSourceSegment + ': ' + allowedSegments);
                if(allowedSegments.contains(normalizedSegmentType)) {
                    System.debug('Normalized segment type ' + normalizedSegmentType + ' is allowed for source segment ' + normalizedSourceSegment);
                    response.isValid = true;
                    response.territoryAssignmentId = assignment.Id;
                    response.warningMessage = null;
                    response.territorySfId = assignment.TerritorySFId__c;

                    return response;
                } 
            }
            
    } 

        return response;
    }

    @AuraEnabled
    public static CreateLeadResponse createLead(CreateLeadRequest requestData) {
        if (requestData == null) {
            throw new AuraHandledException(System.Label.SFA_PJT_LeadDataRequiredMessage);
        }
        Id leadId = requestData.leadId;
        Boolean isInsertFlow = leadId == null || String.isBlank(leadId);

        System.debug('Received CreateLeadRequest: ' + JSON.serialize(requestData));
        normalizeRequest(requestData);
        System.debug('Normalized CreateLeadRequest: ' + JSON.serialize(requestData));

        if (isRepaintingSegment(requestData.segmentType)) {
            requestData.isKeyAccount = 'Yes';
            requestData.keyParentProjectId = getOtherKeyAccountId(true);
            requestData.otherKeyAccount = null;
        }

        String leadStatus;
        if (isInsertFlow) {
            validateCreateRequest(requestData);
            leadStatus =  DEFAULT_STATUS;
        }

        String currentProfileName = getCurrentUserProfileName();
        Boolean isProjectSalesOfficer = isProjectSalesOfficerProfile(currentProfileName);
        Boolean isShareFlow = isProjectSalesOfficer && requestData.shareWithCoOwner == true;
        Boolean isAssignToCoOwnerFlow = isProjectSalesOfficer && requestData.AssignToCoOwner == true;
        Boolean isQueueFlow = /* isProjectSalesOfficer && */ requestData.assignToBusinessQueue == true;
        Boolean createDuplicateRecord = requestData.CreateDuplicate == true;
        Boolean isUpdateCoOwnerFlow = requestData.isUpdateCoOwnerFlow == true;

        if (isUpdateCoOwnerFlow) {
            Lead leadForValidation = [
                SELECT Id, OwnerId, CoOwner__c
                FROM Lead
                WHERE Id = :leadId
                LIMIT 1
            ];
            
            if (leadForValidation.OwnerId != UserInfo.getUserId()) {
                throw new AuraHandledException(System.Label.SFA_PJT_LeadOwnerCannotAssignCoOwnerMessage);
            }
            
            if (leadForValidation.CoOwner__c != null) {
                throw new AuraHandledException(System.Label.SFA_PJT_CoOwnerAlreadyAssignedMessage);
            }
        }

        if (isProjectSalesOfficer && !isUpdateCoOwnerFlow) {
            // Keep existing current-user territory validation behavior for PSO profile.
            validateTerritory(requestData.leadType, requestData.postalCode, requestData.segmentType);
        }

        SaveTerritoryResolution territoryResolution = resolveTerritoryForSave(
            requestData.postalCode,
            requestData.segmentType,
            requestData.track,
            requestData.typeOfAssignment,
            requestData.leadAccountType,
            requestData.assignToBusinessQueue
        );

        if (isShareFlow && !isAssignToCoOwnerFlow && String.isBlank(requestData.sharingPercentageBand)) {
            throw new AuraHandledException(System.Label.SFA_PJT_SharingBandRequiredForCoOwnerFlowMessage);
        }

        Id coOwnerId = null;
        if ((isShareFlow || isAssignToCoOwnerFlow || isUpdateCoOwnerFlow) && !isQueueFlow) {
            if (requestData.suggestedCoOwnerId == null) {
                throw new AuraHandledException(System.Label.SFA_PJT_CoOwnerSuggestionRequiredMessage);
            }

            coOwnerId = getValidatedActiveUserId(requestData.suggestedCoOwnerId);
            if (coOwnerId == null) {
                throw new AuraHandledException(System.Label.SFA_PJT_SuggestedCoOwnerInvalidMessage);
            }
        }

        Id ownerId = UserInfo.getUserId();
        Id psmUserId = null;
        if (!isProjectSalesOfficer && territoryResolution != null && !territoryResolution.isUnmappedTerritory
            && territoryResolution.assignedUserId != null) {
            ownerId = territoryResolution.assignedUserId;
            if(ownerId != UserInfo.getUserId()) {
                psmUserId = ownerId;
            }
        }
        else if( isShareFlow && isAssignToCoOwnerFlow && coOwnerId != null && !isQueueFlow && isProjectSalesOfficer) {
        ownerId = coOwnerId;
        }

        System.debug('Determined ownerId: ' + ownerId);
        System.debug('Is Project Sales Officer: ' + isProjectSalesOfficer);
        System.debug('Is unmapped Territory: ' + territoryResolution.isUnmappedTerritory);
        System.debug('Territory Assignment Id: ' + territoryResolution.assignedUserId);
        
/* 
        String leadStatus = (territoryResolution != null && (territoryResolution.isUnmappedTerritory || !isProjectSalesOfficer))
            ? DEFAULT_STATUS
            : NURTURING_STATUS; */



        //Boolean bypassLeadTerritoryAutomation = !isProjectSalesOfficer;
        //TerritoryAssignmentService.setSkipLeadTerritoryAutomationForCurrentTransaction(bypassLeadTerritoryAutomation);
        Lead safeLead;
        try {
            LeadTriggerHandler.bypassLwc = true;
            if(isInsertFlow) {
                Lead draftLead = new Lead();
                putIfCreateable(draftLead, Lead.OwnerId, ownerId);
                putIfCreateable(draftLead, Lead.Status, leadStatus);
                // Notification flow filters on RecordType.DeveloperName, so it must always be set explicitly rather than relying on the running user's default.
                Id resolvedRecordTypeId = requestData.recordTypeId != null ? requestData.recordTypeId : getProjectSiteRecordTypeId();
                putIfCreateable(draftLead, Lead.RecordTypeId, resolvedRecordTypeId);
                //putIfCreateable(draftLead, Lead.LeadType__c, requestData.leadType);
                putIfCreateable(draftLead, Lead.Company, requestData.company);
                putIfCreateable(draftLead, Lead.FirstName, requestData.firstName);
