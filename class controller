    // Fallback lookup used only when the LWC did not supply a recordTypeId.
    private static Id getProjectSiteRecordTypeId() {
        try {
            if (projectSiteRecordTypeLookupAttempted) {
                return cachedProjectSiteRecordTypeId;
            }
            projectSiteRecordTypeLookupAttempted = true;

            List<RecordType> rtRows = [
                SELECT Id
                FROM RecordType
                WHERE SObjectType = 'Lead'
                  AND DeveloperName = 'ProjectSite'
                LIMIT 1
            ];
            cachedProjectSiteRecordTypeId = rtRows.isEmpty() ? null : rtRows[0].Id;
            return cachedProjectSiteRecordTypeId;
        } catch (Exception ex) {
            Logger.error('Failed to retrieve Project Site Lead record type.', '', ex)
                .addTag('Lead Creation');
            return null;
        } finally {
            Logger.saveLog();
        }
    }

