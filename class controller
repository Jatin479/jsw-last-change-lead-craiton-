    @AuraEnabled
    public static List<CoOwnerUserOption> getEligibleCoOwnerUsers(Id leadId) {
        Set<Id> excludeUserIds = new Set<Id>();
        
        if (leadId != null) {
            List<Lead> leadRows = [
                SELECT OwnerId, CoOwner__c
                FROM Lead
                WHERE Id = :leadId
                LIMIT 1
            ];
            if (!leadRows.isEmpty()) {
                Lead leadRecord = leadRows[0];
                excludeUserIds.add(leadRecord.OwnerId);
                if (leadRecord.CoOwner__c != null) {
                    excludeUserIds.add(leadRecord.CoOwner__c);
                }
            }
        }

        Set<Id> territoryIds = new Set<Id>();
        for (Territory_Assignment__c assignment : [
            SELECT TerritorySFId__c
            FROM Territory_Assignment__c
            WHERE LeadAccountType__c = 'Project Site'
              AND TypeOfAssignment__c = 'Lead'
              AND Track__c = 'SFA_PJT'
              AND Serviceable__c = true
              AND TerritorySFId__c != null
        ]) {
            try {
                territoryIds.add((Id) assignment.TerritorySFId__c);
            } catch (Exception ex) {
                continue;
            }
        }

        List<CoOwnerUserOption> options = new List<CoOwnerUserOption>();
        if (territoryIds.isEmpty()) {
            return options;
        }

        Map<Id, CoOwnerUserOption> optionsByUserId = new Map<Id, CoOwnerUserOption>();
        for (UserTerritory2Association association : [
            SELECT UserId, User.Name, Territory2Id
            FROM UserTerritory2Association
            WHERE Territory2Id IN :territoryIds
              AND UserId != null
              AND UserId NOT IN :excludeUserIds
        ]) {
            if (!optionsByUserId.containsKey(association.UserId)) {
                optionsByUserId.put(
                    association.UserId,
                    new CoOwnerUserOption(association.UserId, association.User.Name, association.Territory2Id)
                );
            }
        }

        options.addAll(optionsByUserId.values());
        return options;
    }


