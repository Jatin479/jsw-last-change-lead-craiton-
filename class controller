                putIfCreateable(draftLead, Lead.Landmark__c, requestData.landmark);
                putIfCreateable(draftLead, Lead.PostalCode, sanitizePincode(requestData.postalCode));
                putIfCreateable(draftLead, Lead.CountryCode, DEFAULT_COUNTRY_CODE);
                
                if(isShareFlow && coOwnerId != null && !isAssignToCoOwnerFlow && !isQueueFlow) {
                    putIfCreateable(draftLead, Lead.CoOwner__c, coOwnerId);
                    putIfCreateable(draftLead, Lead.SharingPercentageBand__c, requestData.sharingPercentageBand);
                }

                if(isProjectSalesOfficer && territoryResolution != null && !requestData.assignToBusinessQueue && requestData.territoryAssignmentId != null) {
                    putIfCreateable(draftLead, Lead.SFA_PJT_Territory_Assignment__c, requestData.territoryAssignmentId);
                }

                SObjectAccessDecision decision = Security.stripInaccessible(AccessType.CREATABLE, new List<SObject>{ draftLead });
                safeLead = (Lead) decision.getRecords()[0];
                Database.DMLOptions dml = new Database.DMLOptions();
                dml.DuplicateRuleHeader.allowSave = createDuplicateRecord;
                dml.DuplicateRuleHeader.runAsCurrentUser = true;

                Database.SaveResult result = Database.insert(safeLead, dml);

                if (!result.isSuccess()) {
                    throw new AuraHandledException(result.getErrors()[0].getMessage());
                }
                
            }//if
            else{
                Lead existingLead = [
                    SELECT Id, OwnerId, Status, SharingPercentageBand__c, CoOwner__c, SFA_PJT_Territory_Assignment__c
                    FROM Lead
                    WHERE Id = :leadId
                    LIMIT 1
                ];

                if (existingLead == null) {
                    throw new AuraHandledException(System.Label.SFA_PJT_LeadNotFoundMessage);
                }
                putIfCreateable(existingLead, Lead.OwnerId, ownerId);
                //putIfCreateable(existingLead, Lead.Status, leadStatus);

                if(isShareFlow && coOwnerId != null && !isAssignToCoOwnerFlow && !isQueueFlow && isProjectSalesOfficer) {
                    putIfCreateable(existingLead, Lead.CoOwner__c, coOwnerId);
                    putIfCreateable(existingLead, Lead.SharingPercentageBand__c, requestData.sharingPercentageBand);
                }
                else{
                    putIfCreateable(existingLead, Lead.CoOwner__c, null);
                    putIfCreateable(existingLead, Lead.SharingPercentageBand__c, null);
                }

                if( !isUpdateCoOwnerFlow && isProjectSalesOfficer && !requestData.assignToBusinessQueue && requestData.territoryAssignmentId != null) {
                    putIfCreateable(existingLead, Lead.SFA_PJT_Territory_Assignment__c, requestData.territoryAssignmentId);
                }

                update existingLead;
                safeLead = existingLead;
            }//else 

                if(isProjectSalesOfficer /* && territoryResolution != null */ && !requestData.assignToBusinessQueue && safeLead.Id != null && requestData.territorySfId != null) {
                    Map<Id, Id> desiredTerritoryByRecord = new Map<Id, Id>();

                    if(isAssignToCoOwnerFlow || isShareFlow || isUpdateCoOwnerFlow) {
                        list<UserTerritory2Association> userTerritoryAssociations = [select id , UserId, Territory2Id from UserTerritory2Association where UserId = :ownerId];
                        for(UserTerritory2Association uta : userTerritoryAssociations) {
                            if(uta.Territory2Id != requestData.territorySfId) {
                                desiredTerritoryByRecord.put(safeLead.Id, uta.Territory2Id);
                                System.debug('Desired Territory By Record1: ' + desiredTerritoryByRecord);
                                TerritoryAssignmentService.syncAssociations('Lead', new Set<Id>{safeLead.Id}, desiredTerritoryByRecord);
                                break;
                            }
                        }
                    }                    
                    
                    desiredTerritoryByRecord.put(safeLead.Id, requestData.territorySfId);
                    System.debug('Desired Territory By Record: ' + desiredTerritoryByRecord);
                    TerritoryAssignmentService.syncAssociations('Lead', new Set<Id>{safeLead.Id}, desiredTerritoryByRecord);
                
                }
            

        } catch (DmlException ex) {
            Logger.error('Failed to save lead in createLead.', leadId, ex).addTag('Lead Creation');
            throw new AuraHandledException(getUserFriendlyDmlMessage(ex));
        } finally {
            LeadTriggerHandler.bypassLwc = false;
            Logger.saveLog();
        }


        if (isQueueFlow) {
            String effectiveTrack = String.isBlank(requestData.track) ? deriveTrackFromCurrentUserRole() : requestData.track;
            String effectiveLeadAccountType = String.isBlank(requestData.leadAccountType) ? DEFAULT_LEAD_ACCOUNT_TYPE : requestData.leadAccountType;
            notifyBusinessManagersForUnmappedPin(
                sanitizePincode(requestData.postalCode),
                requestData.segmentType,
                effectiveTrack,
                effectiveLeadAccountType,
                safeLead.Id
            );
        }

        if (isProjectSalesOfficer && coOwnerId != null) {
            notifyUser(safeLead.Id, coOwnerId, LEAD_COOWNER_TEMPLATE_DEV_NAME );
            sendBellNotificationToPSM(safeLead.Id, coOwnerId, requestData.company);
        }
        else if (psmUserId != null) {
            notifyUser(safeLead.Id, psmUserId, LEAD_PSM_TEMPLATE_DEV_NAME );
            sendBellNotificationToPSM(safeLead.Id, psmUserId, requestData.company);
        }

        CreateLeadResponse response = new CreateLeadResponse();
        response.leadId = safeLead.Id;
        response.message = isInsertFlow ? System.Label.SFA_PJT_LeadCreatedSuccessMessage : System.Label.SFA_PJT_LeadUpdatedSuccessMessage;
        response.ownerId = safeLead.OwnerId;
        return response;
    }

    private static SaveTerritoryResolution resolveTerritoryForSave(
        String pincode,
        String segment,
        String track,
        String typeOfAssignment,
        String leadAccountType,
        Boolean assignToBusinessQueue
    ) {
        SaveTerritoryResolution response = new SaveTerritoryResolution();
        response.isUnmappedTerritory = assignToBusinessQueue;

        String sanitizedPincode = sanitizePincode(pincode);
        System.debug('Sanitized pincode: ' + sanitizedPincode);
        System.debug('Segment: ' + segment);
        if (String.isBlank(sanitizedPincode) || String.isBlank(segment)) {
            return response;
        }

        String queryPincode = parsePincodeForQuery(sanitizedPincode);
        System.debug('Parsed query pincode: ' + queryPincode);
        if (queryPincode == null) {
            return response;
        }

        String effectiveTrack = String.isBlank(track) ? deriveTrackFromCurrentUserRole() : track.trim();
        System.debug('Effective track: ' + effectiveTrack);
        if (String.isBlank(effectiveTrack)) {
            return response;
        }

        String effectiveAssignmentType = String.isBlank(typeOfAssignment) ? ASSIGNMENT_TYPE_LEAD : typeOfAssignment.trim();
        String effectiveLeadAccountType = String.isBlank(leadAccountType) ? DEFAULT_LEAD_ACCOUNT_TYPE : leadAccountType.trim();

        Map<String, Set<String>> allowedSegmentsBySourceSegment = getAllowedSegmentsBySourceSegment();
        String normalizedInputSegment = normalizeKeyPart(segment);

        List<Territory_Assignment__c> assignmentRows = queryLeadTerritoryAssignments(
            effectiveTrack,
            effectiveAssignmentType,
            effectiveLeadAccountType,
            queryPincode
        );

        Territory_Assignment__c chosenAssignment = getchoosenTerritoryAssignment(assignmentRows, normalizedInputSegment, allowedSegmentsBySourceSegment);
        System.debug('Chosen assignment: ' + chosenAssignment);

        if (chosenAssignment == null) {
            return response;
        }

        //response.isUnmappedTerritory = false;
        response.territoryAssignmentId = chosenAssignment.Id;

        String areaSfId = getStringFieldValue(chosenAssignment, 'AreaSFId__c');
        response.areaSfId = areaSfId;
        response.assignedUserId = resolveAssignedUserByAreaTerritory(areaSfId);

        return response;
    }

    private static List<Territory_Assignment__c> queryLeadTerritoryAssignments(
        String effectiveTrack,
        String effectiveAssignmentType,
        String effectiveLeadAccountType,
        String queryPincode
    ) {
        Boolean hasAreaField = Schema.SObjectType.Territory_Assignment__c.fields.getMap().containsKey('AreaSFId__c');
        String query = 'SELECT Id, Segment__c, TerritorySFId__c';
        if (hasAreaField) {
            query += ', AreaSFId__c';
        }
        query += ' FROM Territory_Assignment__c'
            + ' WHERE Track__c = :effectiveTrack'
            + ' AND Serviceable__c = true'
            + ' AND TypeOfAssignment__c = :effectiveAssignmentType'
            + ' AND LeadAccountType__c = :effectiveLeadAccountType'
            + ' AND Pincode__c = :queryPincode'
            + ' ORDER BY LastModifiedDate DESC';

        return Database.query(query);
    }

    private static String getStringFieldValue(SObject row, String fieldApiName) {
        if (row == null || String.isBlank(fieldApiName)) {
            return null;
        }
        Map<String, Object> populatedFields = row.getPopulatedFieldsAsMap();
        if (!populatedFields.containsKey(fieldApiName)) {
            return null;
        }
        Object rawValue = populatedFields.get(fieldApiName);
        if (rawValue == null) {
            return null;
        }
        String asText = String.valueOf(rawValue).trim();
        return String.isBlank(asText) ? null : asText;
    }

    private static Id resolveAssignedUserByAreaTerritory(String areaSfId) {
        if (!isValidSalesforceId(areaSfId)) {
            return null;
        }

        Id territoryId = (Id) areaSfId;
        List<UserTerritory2Association> territoryUsers = [
            SELECT UserId
            FROM UserTerritory2Association
            WHERE Territory2Id = :territoryId
              AND User.IsActive = true
              AND User.Profile.Name =: System.Label.SFA_PJT_ProjectSalesManagerProfileName
            ORDER BY LastModifiedDate DESC
            LIMIT 1
        ];
        return territoryUsers.isEmpty() ? null : territoryUsers[0].UserId;
    }

    private static Boolean isValidSalesforceId(String value) {
        if (String.isBlank(value)) {
            return false;
        }
        String trimmed = value.trim();
        Integer length = trimmed.length();
        if (length != 15 && length != 18) {
            return false;
        }
        return Pattern.matches('[a-zA-Z0-9]{15,18}', trimmed);
    }

    private static String getCurrentUserProfileName() {
        List<User> users = [
            SELECT Profile.Name
            FROM User
            WHERE Id = :UserInfo.getUserId()
            LIMIT 1
        ];
        if (users.isEmpty() || users[0].Profile == null) {
            return null;
        }
        return users[0].Profile.Name;
    }

    private static Boolean isProjectSalesOfficerProfile(String profileName) {
        return String.isNotBlank(profileName) && PROJECT_SALES_OFFICER_PROFILE_NAMES.contains(profileName);
    }

