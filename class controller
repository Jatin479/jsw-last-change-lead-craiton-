    private static Id getOtherKeyAccountId(Boolean logErrors) {
        try {
            String keyAccountRecordTypeName = System.Label.SFA_PJT_KeyAccountRecordtypeName;
            List<Account> otherAccounts = [
                SELECT Id
                FROM Account
                WHERE Name = 'Other'
                  AND RecordType.DeveloperName = :keyAccountRecordTypeName
                LIMIT 1
            ];
            if (otherAccounts.isEmpty()) {
                throw new AuraHandledException('The Account named Other with the configured Key Account record type is not configured.');
            }
            return otherAccounts[0].Id;
        } catch (AuraHandledException ex) {
            if (logErrors) {
                Logger.error('The configured Other Key Account was not found.', '', ex)
                    .addTag('Lead Creation');
            }
            throw ex;
        } catch (Exception ex) {
            if (logErrors) {
                Logger.error('Failed to retrieve the Other Key Account.', '', ex)
                    .addTag('Lead Creation');
            }
            throw new AuraHandledException('Unable to retrieve the configured Other Key Account.');
        } finally {
            if (logErrors) {
                Logger.saveLog();
            }
        }
    }

